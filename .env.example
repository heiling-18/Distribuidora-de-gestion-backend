NODE_ENV=development
PORT=4000
# Postgres (ej. Supabase -> Settings -> Database -> Connection string)
DATABASE_URL=postgresql://usuario:clave@localhost:5432/dyms
# Origen del frontend permitido por CORS
CORS_ORIGIN=http://localhost:3000
# Secreto para firmar los JWT (mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
TZ_NEGOCIO=America/Bogota
