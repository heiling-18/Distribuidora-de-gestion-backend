NODE_ENV=development
PORT=4000
# PostgreSQL local (rol y bases los crea scripts/crear-bd-local.ps1)
DATABASE_URL=postgresql://dyms:cambia-esta-clave@localhost:5432/dyms_dev
DATABASE_URL_TEST=postgresql://dyms:cambia-esta-clave@localhost:5432/dyms_test
# Origen del frontend permitido por CORS
CORS_ORIGIN=http://localhost:3000
# Secreto para firmar los JWT (mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
TZ_NEGOCIO=America/Bogota

# Clave de los usuarios de prueba que crea npm run db:seed (solo desarrollo)
SEED_PASSWORD=dyms-dev-2026

# Sesión
SESION_HORAS=12
# lax si frontend y API comparten dominio; none si están en dominios distintos (exige HTTPS)
COOKIE_SAMESITE=lax
